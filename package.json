{
  "name": "maps-region-switcher",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "MV3 extension (Chrome + Firefox) that loads Google Maps with a chosen region parameter.",
  "scripts": {
    "test": "node tools/test-rules.mjs",
    "icons": "python3 tools/make_icons.py",
    "build": "node tools/build.mjs all",
    "build:chrome": "node tools/build.mjs chrome",
    "build:firefox": "node tools/build.mjs firefox",
    "firefox:run": "web-ext run --source-dir dist/firefox",
    "firefox:lint": "web-ext lint --source-dir dist/firefox"
  },
  "license": "MIT"
}
